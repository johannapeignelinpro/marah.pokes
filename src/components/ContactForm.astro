---
import { Image } from 'astro:assets';
import motifImage from '../assets/images/editorial/marah-handpoke-motif-organique-rennes.jpg';
---

<section id="contact" class="contact">
  <div class="container contact-layout">
    <div class="contact-aside" data-reveal>
      <span class="eyebrow">Rendez-vous</span>
      <h2>Prendre rendez-vous</h2>
      <p class="contact-intro">
        Intéressé·e par un tatouage handpoke ? Remplissez ce formulaire pour
        discuter de votre projet. Je vous répondrai dans les plus brefs délais.
      </p>

      <div class="patience-message">
        <p>
          J’accepte de discuter de tout projet pour l’adapter à mon univers. Si cela ne correspond pas, je vous guiderai vers un ou une autre artiste adapté.e.
        </p>
        <p>
          La sortie d'aiguille est de 100&nbsp;€, ensuite, le prix sera variable en fonction de la taille, de l'emplacement et bien sûr, de la difficulté du projet.
        </p>
        <p>
Vos demandes seront traitées dès que possible. Je vous réponds au plus vite afin de discuter des détails de la conception et fixer votre rendez vous. Merci pour votre patience et votre compréhension.
        </p>
      </div>
    </div>

    <form
      class="contact-form"
      id="contact-form"
      name="demande-tatouage"
      method="POST"
      action="/merci/"
      enctype="multipart/form-data"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
    >
      <!-- Identifiant du formulaire pour Netlify Forms (requis pour l'envoi en AJAX) -->
      <input type="hidden" name="form-name" value="demande-tatouage" />

      <!-- Informations personnelles -->
      <!-- Honeypot anti-bot (champ invisible) -->
      <input
        type="text"
        name="bot-field"
        id="bot-field"
        style="display:none !important; position:absolute; left:-9999px;"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <div class="form-row">
        <div class="form-group">
          <label for="name">Nom & Prénom *</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            maxlength="100"
            placeholder="Votre nom complet"
          />
          <span class="error-message" id="error-name"></span>
        </div>

        <div class="form-group">
          <label for="email">Email *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            maxlength="255"
            placeholder="votre@email.com"
          />
          <span class="error-message" id="error-email"></span>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="phone">Téléphone</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            maxlength="20"
            placeholder="06 12 34 56 78"
          />
          <span class="error-message" id="error-phone"></span>
        </div>

        <div class="form-group">
          <label for="instagram">Profil Instagram</label>
          <input
            type="text"
            id="instagram"
            name="instagram"
            maxlength="50"
            placeholder="@votre_pseudo"
          />
          <span class="error-message" id="error-instagram"></span>
        </div>
      </div>

      <!-- Type de projet -->
      <div class="form-group">
        <label>Type de projet *</label>
        <div class="project-type-options">
          <label class="radio-option">
            <input
              type="radio"
              name="project-type"
              value="flash"
              id="type-flash"
              required
            />
            <span class="radio-label">Flash (dessin pré-réalisé)</span>
          </label>
          <label class="radio-option">
            <input
              type="radio"
              name="project-type"
              value="freehand"
              id="type-freehand"
              required
            />
            <span class="radio-label">Projet Perso</span>
          </label>
        </div>
      </div>

      <!-- ============================== -->
      <!-- SECTION FLASH (conditionnelle) -->
      <!-- ============================== -->
      <div id="section-flash" class="form-section" style="display: none;">
        <h3 class="form-section-title">Votre flash</h3>

        <div class="form-group">
          <label for="flash-photo">Photo du flash souhaité *</label>
          <div class="file-upload-area" id="flash-upload-area">
            <input
              type="file"
              id="flash-photo"
              name="flash-photo"
              accept="image/*"
              class="file-input"
            />
            <label for="flash-photo" class="file-label">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span>Choisir la photo du flash</span>
            </label>
            <div id="flash-file-list" class="file-list"></div>
          </div>
          <span class="error-message" id="error-flash-photo"></span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="flash-body-part">Partie du corps *</label>
            <input
              type="text"
              id="flash-body-part"
              name="flash-body-part"
              maxlength="100"
              placeholder="Ex : poignet, cheville, épaule..."
            />
            <span class="error-message" id="error-flash-body-part"></span>
          </div>
          <div class="form-group">
            <label for="flash-size">Taille (cm) *</label>
            <input
              type="text"
              id="flash-size"
              name="flash-size"
              maxlength="50"
              placeholder="Ex : 5 × 5 cm"
            />
            <span class="error-message" id="error-flash-size"></span>
          </div>
        </div>

        <div class="form-group">
          <label for="flash-notes">Demandes complémentaires <span class="optional">(optionnel)</span></label>
          <textarea
            id="flash-notes"
            name="flash-notes"
            maxlength="1000"
            placeholder="Modifications mineures souhaitées, ajouts, précisions..."
            rows="3"
          ></textarea>
        </div>

        <div class="form-group">
          <label for="flash-availability">Disponibilités *</label>
          <textarea
            id="flash-availability"
            name="flash-availability"
            placeholder="Indiquez vos disponibilités (jours, créneaux horaires...)"
            rows="3"
          ></textarea>
          <span class="error-message" id="error-flash-availability"></span>
        </div>
      </div>

      <!-- ================================== -->
      <!-- SECTION PROJET PERSO (conditionnelle) -->
      <!-- ================================== -->
      <div id="section-projet-perso" class="form-section" style="display: none;">
        <h3 class="form-section-title">Votre projet</h3>

        <div class="form-row">
          <div class="form-group">
            <label for="perso-body-part">Partie du corps *</label>
            <input
              type="text"
              id="perso-body-part"
              name="perso-body-part"
              maxlength="100"
              placeholder="Ex : poignet, cheville, épaule..."
            />
            <span class="error-message" id="error-perso-body-part"></span>
          </div>
          <div class="form-group">
            <label for="perso-size">Taille (cm) *</label>
            <input
              type="text"
              id="perso-size"
              name="perso-size"
              maxlength="50"
              placeholder="Ex : 5 × 5 cm"
            />
            <span class="error-message" id="error-perso-size"></span>
          </div>
        </div>

        <!-- Upload de photos inspiration -->
        <div class="form-group">
          <label for="photos">Photos de mon travail qui vous inspirent</label>
          <div class="file-upload-area" id="file-upload-area">
            <input
              type="file"
              id="photos"
              name="photos"
              multiple
              accept="image/*"
              class="file-input"
            />
            <label for="photos" class="file-label">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span>Ajouter des photos (5 max)</span>
            </label>
            <div id="file-list" class="file-list"></div>
            <!-- Champs techniques : un fichier par champ côté Netlify Forms. Les photos
                 suivantes (glisser-déposer compris) sont envoyées via ces champs. -->
            <input type="file" name="photos-2" accept="image/*" hidden tabindex="-1" aria-hidden="true" />
            <input type="file" name="photos-3" accept="image/*" hidden tabindex="-1" aria-hidden="true" />
            <input type="file" name="photos-4" accept="image/*" hidden tabindex="-1" aria-hidden="true" />
            <input type="file" name="photos-5" accept="image/*" hidden tabindex="-1" aria-hidden="true" />
          </div>
          <span class="error-message" id="error-photos"></span>
        </div>

        <!-- Description du projet -->
        <div class="form-group">
          <label for="project">Décrivez votre projet de tatouage *</label>
          <textarea
            id="project"
            name="project"
            maxlength="2000"
            placeholder=" Les petits détails font les grandes histoires, n’hésitez pas à être exhaustif.ve si vous le souhaitez. Donnez des infos sur l’emplacement, taille approximative souhaitée..."
          ></textarea>
          <span class="error-message" id="error-project"></span>
          <div class="warning-message" id="warning-project" style="display: none;"></div>
        </div>

        <!-- Budget -->
        <div class="form-group">
          <label for="budget">Budget envisagé</label>
          <select id="budget" name="budget">
            <option value="">Sélectionnez une fourchette</option>
            <option value="100-200">100€ - 200€</option>
            <option value="200-300">200€ - 300€</option>
            <option value="300-400">300€ - 400€</option>
            <option value="libre">Ton prix sera le mien</option>
          </select>
        </div>

        <!-- Disponibilités -->
        <div class="form-group">
          <label for="availability">Disponibilités</label>
          <textarea
            id="availability"
            name="availability"
            placeholder="Indiquez vos disponibilités (jours, créneaux horaires...)"
            rows="3"
          ></textarea>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="submit-button">
          Envoyer la demande
        </button>
      </div>

      <!-- Retour d'envoi (succès / erreur) -->
      <p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p>

      <!-- Badge de sécurité -->
      <div class="security-badge">
        Formulaire sécurisé - Vos données sont protégées
      </div>

      <p class="form-note">
        * Champs obligatoires
      </p>
    </form>

    <!-- Photo de clôture : motif végétal en cours de tatouage -->
    <figure class="frame contact-visual">
      <div class="frame-inner">
        <Image
          src={motifImage}
          alt="Motif végétal en ligne fine tatoué au handpoke, en cours de réalisation"
          widths={[640, 1200, motifImage.width]}
          sizes="(max-width: 1200px) 100vw, 1136px"
          loading="lazy"
        />
      </div>
    </figure>
  </div>
</section>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: var(--spacing-lg);
    align-items: start;
  }

  .contact-intro {
    color: var(--ink-soft);
    margin-bottom: var(--spacing-md);
  }

  /* Infos pratiques : liste fine avec tiret rouille */
  .patience-message {
    border-top: 1px solid var(--line);
  }

  .patience-message p {
    position: relative;
    padding: 1rem 0 1rem 1.75rem;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line);
  }

  .patience-message p::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.9rem;
    width: 0.9rem;
    height: 1px;
    background: var(--link);
  }

  .contact-visual {
    grid-column: 1 / -1;
  }

  .contact-visual img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 42%;
  }

  /* Formulaire centré verticalement face au texte de gauche. Quand il s'allonge
     (choix Flash / Projet perso), c'est lui qui donne la hauteur : le texte de
     gauche reste en place. */
  .contact-form {
    align-self: center;
    background-color: var(--surface);
    padding: 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-img);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
  }

  /* Radio options pour type de projet */
  .project-type-options {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .radio-option {
    flex: 1;
    min-width: 200px;
    display: flex;
    align-items: center;
    padding: 0.9rem 1rem;
    margin: 0;
    border: 1px solid var(--line-input);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .radio-option:hover {
    border-color: var(--link);
  }

  .radio-option input[type="radio"] {
    margin-right: 0.75rem;
    cursor: pointer;
    accent-color: var(--link);
  }

  .radio-option:has(input[type="radio"]:checked) {
    border-color: var(--link);
    background-color: var(--tint);
  }

  .radio-label {
    cursor: pointer;
    font-family: var(--f-body);
    font-size: 1.0625rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-soft);
  }

  .radio-option input[type="radio"]:checked + .radio-label {
    color: var(--ink);
  }

  /* Error message */
  .error-message {
    display: block;
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--error);
  }

  .error-message:empty {
    display: none;
  }

  .form-group.has-error input,
  .form-group.has-error textarea,
  .form-group.has-error select {
    border-color: var(--error);
  }

  /* Warning message */
  .warning-message {
    display: block;
    margin-top: 0.5rem;
    padding: 0.75rem;
    background-color: var(--warning-bg);
    border-left: 2px solid var(--warning-line);
    font-size: var(--fs-small);
    color: var(--warning);
  }

  .warning-message:empty {
    display: none;
  }

  /* Security badge */
  .security-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--spacing-md);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .security-badge::before {
    content: '🔒';
    font-size: 0.9rem;
  }

  /* File upload area */
  .file-upload-area {
    position: relative;
  }

  .file-input {
    display: none;
  }

  .file-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.75rem 1rem;
    margin: 0.25rem 0 0;
    border: 1px dashed var(--line-input);
    border-radius: var(--radius-img);
    cursor: pointer;
    transition: border-color 0.3s ease;
    text-align: center;
  }

  .file-label:hover {
    border-color: var(--link);
  }

  .file-label svg {
    color: var(--link);
  }

  .file-label span {
    font-family: var(--f-body);
    font-size: 1rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-muted);
  }

  .file-list {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Lignes créées en JS : :global, sinon le style scopé d'Astro ne s'y applique pas */
  .file-list :global(.file-item) {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background-color: var(--bg-alt);
    font-size: 1rem;
  }

  .file-list :global(.file-item-name) {
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-list :global(.file-item-remove) {
    background: none;
    border: none;
    color: var(--link);
    cursor: pointer;
    font-size: 1.35rem;
    line-height: 1;
    /* Cible tactile confortable (~40 px) sans agrandir la pastille */
    flex-shrink: 0;
    min-width: 2.5rem;
    min-height: 2.5rem;
    margin: -0.5rem -0.75rem -0.5rem 0;
  }

  .file-list :global(.file-item-remove:hover) {
    color: var(--ink);
  }

  .file-list :global(.file-item--pending) {
    color: var(--ink-muted);
    font-style: italic;
  }

  .form-actions {
    margin-top: var(--spacing-md);
  }

  .form-actions .btn {
    width: 100%;
  }

  .form-note {
    margin-top: var(--spacing-sm);
    font-size: var(--fs-small);
    color: var(--ink-muted);
    text-align: center;
  }

  .form-status {
    margin-top: var(--spacing-sm);
    padding: 0.75rem;
    font-size: var(--fs-small);
    text-align: center;
  }

  .form-status.is-success {
    border-left: 2px solid var(--link);
    background-color: var(--tint);
    color: var(--ink);
  }

  .form-status.is-error {
    border-left: 2px solid var(--error);
    background-color: var(--error-bg);
    color: var(--error);
  }

  /* Sections Flash / Projet Perso */
  .form-section {
    margin-top: var(--spacing-sm);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--line);
  }

  .form-section-title {
    font-size: 1.6rem;
    margin-bottom: var(--spacing-md);
  }

  .optional {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.95em;
  }

  @media screen and (max-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }

  /* Mobile : format vertical, centré sur le motif */
  @media screen and (max-width: 768px) {
    .contact-visual img {
      aspect-ratio: 4 / 5;
      object-position: center 50%;
    }
  }

  @media screen and (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .contact-form {
      padding: 1.5rem 1.25rem;
    }

    .project-type-options {
      flex-direction: column;
    }

    .radio-option {
      min-width: 100%;
    }
  }
</style>

<script>
  import {
    validateEmail,
    validatePhone,
    validateInstagram,
    validateTextLength,
    containsURL,
    countURLs,
    validateFiles,
    validateImageFile,
    validateFormData,
    type FormData as SecurityFormData
  } from '../utils/formSecurity';

  // =======================
  // ÉLÉMENTS DU FORMULAIRE
  // =======================
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const flashRadio = document.getElementById('type-flash') as HTMLInputElement | null;
  const freehandRadio = document.getElementById('type-freehand') as HTMLInputElement | null;
  const sectionFlash = document.getElementById('section-flash') as HTMLElement | null;
  const sectionProjetPerso = document.getElementById('section-projet-perso') as HTMLElement | null;
  const projectTextarea = document.getElementById('project') as HTMLTextAreaElement | null;
  const honeypotField = document.getElementById('bot-field') as HTMLInputElement | null;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement | null;
  const formStatus = document.getElementById('form-status') as HTMLElement | null;

  // Netlify Forms : 8 Mo maximum par envoi (fichiers compris)
  const MAX_SUBMISSION_SIZE = 8 * 1024 * 1024;

  const SUCCESS_MESSAGE =
    'Merci, ta demande a bien été envoyée. Marah reviendra vers toi dès que possible.';
  const ERROR_MESSAGE =
    "Oups, l'envoi n'a pas fonctionné. Vérifie ta connexion et réessaie, ou contacte Marah directement sur Instagram @marah.pokes.";

  function showStatus(type: 'success' | 'error', message: string) {
    if (!formStatus) return;
    formStatus.textContent = message;
    formStatus.classList.remove('is-success', 'is-error');
    formStatus.classList.add(type === 'success' ? 'is-success' : 'is-error');
    formStatus.hidden = false;
    formStatus.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function hideStatus() {
    if (!formStatus) return;
    formStatus.hidden = true;
    formStatus.textContent = '';
  }

  // =======================
  // AFFICHAGE DES ERREURS
  // =======================
  function showError(fieldId: string, message: string) {
    const errorElement = document.getElementById(`error-${fieldId}`);
    const formGroup = document.getElementById(fieldId)?.closest('.form-group');

    if (errorElement) {
      errorElement.textContent = message;
    }
    if (formGroup) {
      formGroup.classList.add('has-error');
    }
  }

  function clearError(fieldId: string) {
    const errorElement = document.getElementById(`error-${fieldId}`);
    const formGroup = document.getElementById(fieldId)?.closest('.form-group');

    if (errorElement) {
      errorElement.textContent = '';
    }
    if (formGroup) {
      formGroup.classList.remove('has-error');
    }
  }

  function clearAllErrors() {
    const errorMessages = document.querySelectorAll('.error-message');
    errorMessages.forEach(el => el.textContent = '');

    const formGroups = document.querySelectorAll('.form-group.has-error');
    formGroups.forEach(el => el.classList.remove('has-error'));
  }

  // =======================
  // GESTION TYPE DE PROJET
  // =======================
  function updateFormFields() {
    if (!flashRadio || !freehandRadio || !sectionFlash || !sectionProjetPerso) return;

    if (flashRadio.checked) {
      sectionFlash.style.display = 'block';
      sectionProjetPerso.style.display = 'none';
    } else if (freehandRadio.checked) {
      sectionFlash.style.display = 'none';
      sectionProjetPerso.style.display = 'block';
    }
  }

  if (flashRadio && freehandRadio) {
    flashRadio.addEventListener('change', updateFormFields);
    freehandRadio.addEventListener('change', updateFormFields);
  }

  // =======================
  // UPLOAD DE FICHIERS
  // =======================
  // Les photos de téléphone pèsent souvent 3 à 6 Mo : deux suffiraient à dépasser
  // la limite de 8 Mo de Netlify. Elles sont donc réduites dans le navigateur
  // (2000 px de côté max, JPEG) dès qu'elles sont choisies.
  const MAX_PHOTOS = 5;
  const MAX_DIMENSION = 2000;

  async function compressImage(file: File): Promise<File> {
    const alreadyLight =
      file.size < 1.2 * 1024 * 1024 && ['image/jpeg', 'image/png', 'image/webp'].includes(file.type);
    if (alreadyLight || file.type === 'image/gif') return file;

    try {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, MAX_DIMENSION / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      const context = canvas.getContext('2d');
      if (!context) return file;
      // Fond blanc : les zones transparentes d'un PNG ne deviennent pas noires en JPEG
      context.fillStyle = '#ffffff';
      context.fillRect(0, 0, canvas.width, canvas.height);
      context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();

      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.85));
      if (!blob || blob.size >= file.size) return file;
      const name = file.name.replace(/\.[^.]+$/, '') + '.jpg';
      return new File([blob], name, { type: 'image/jpeg', lastModified: file.lastModified });
    } catch {
      // Format que ce navigateur ne sait pas décoder (HEIC hors Safari…) : envoyé tel quel
      return file;
    }
  }

  function formatSize(bytes: number) {
    return bytes < 1024 * 1024
      ? `${Math.max(1, Math.round(bytes / 1024))} Ko`
      : `${(bytes / 1024 / 1024).toFixed(1).replace('.', ',')} Mo`;
  }

  function renderFileList(container: HTMLElement | null, files: File[], onRemove: (index: number) => void) {
    if (!container) return;
    container.innerHTML = '';

    files.forEach((file, index) => {
      const fileItem = document.createElement('div');
      fileItem.className = 'file-item';

      const fileName = document.createElement('span');
      fileName.className = 'file-item-name';
      fileName.textContent = `${file.name} · ${formatSize(file.size)}`;

      const removeBtn = document.createElement('button');
      removeBtn.className = 'file-item-remove';
      removeBtn.type = 'button';
      removeBtn.textContent = '×';
      removeBtn.setAttribute('aria-label', `Retirer ${file.name}`);
      removeBtn.addEventListener('click', () => onRemove(index));

      fileItem.appendChild(fileName);
      fileItem.appendChild(removeBtn);
      container.appendChild(fileItem);
    });
  }

  function showPreparing(container: HTMLElement | null) {
    if (!container) return;
    const note = document.createElement('div');
    note.className = 'file-item file-item--pending';
    note.textContent = 'Préparation de la photo…';
    container.appendChild(note);
  }

  // Compression en cours : l'envoi attend qu'elle soit terminée
  let pendingFiles: Promise<unknown> = Promise.resolve();

  // --- Photos d'inspiration (projet perso) : jusqu'à 5, ajoutées une par une ou ensemble ---
  const fileInput = document.getElementById('photos') as HTMLInputElement | null;
  const fileUploadArea = document.getElementById('file-upload-area') as HTMLElement | null;
  const fileList = document.getElementById('file-list') as HTMLElement | null;
  let selectedFiles: File[] = [];

  function updateFileList() {
    renderFileList(fileList, selectedFiles, (index) => {
      selectedFiles.splice(index, 1);
      clearError('photos');
      updateFileList();
    });
  }

  function addPhotos(files: File[]) {
    clearError('photos');
    if (files.length === 0) return;

    const validation = validateFiles(files);
    if (!validation.valid) {
      showError('photos', validation.error!);
      return;
    }

    const room = MAX_PHOTOS - selectedFiles.length;
    if (room <= 0) {
      showError('photos', `${MAX_PHOTOS} photos maximum : retire une photo pour en ajouter une autre.`);
      return;
    }

    const accepted = files.slice(0, room);
    showPreparing(fileList);
    pendingFiles = Promise.all(accepted.map(compressImage)).then((compressed) => {
      selectedFiles = [...selectedFiles, ...compressed];
      updateFileList();
      if (files.length > room) {
        showError('photos', `${MAX_PHOTOS} photos maximum : seules les premières ont été ajoutées.`);
      }
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', () => {
      const files = Array.from(fileInput.files ?? []);
      // On vide le champ : la sélection suivante s'ajoute à la liste (et la même
      // photo peut être choisie à nouveau après l'avoir retirée)
      fileInput.value = '';
      addPhotos(files);
    });
  }

  // Glisser-déposer (ordinateur)
  if (fileUploadArea) {
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
      fileUploadArea.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
      });
    });

    ['dragenter', 'dragover'].forEach(eventName => {
      fileUploadArea.addEventListener(eventName, () => {
        fileUploadArea.style.borderColor = 'var(--link)';
        fileUploadArea.style.backgroundColor = 'var(--tint)';
      });
    });

    ['dragleave', 'drop'].forEach(eventName => {
      fileUploadArea.addEventListener(eventName, () => {
        fileUploadArea.style.borderColor = '';
        fileUploadArea.style.backgroundColor = '';
      });
    });

    fileUploadArea.addEventListener('drop', (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (dt?.files) addPhotos(Array.from(dt.files));
    });
  }

  // --- Photo du flash : une seule, affichée une fois choisie ---
  const flashInput = document.getElementById('flash-photo') as HTMLInputElement | null;
  const flashFileList = document.getElementById('flash-file-list') as HTMLElement | null;
  let flashFile: File | null = null;

  function updateFlashFile() {
    renderFileList(flashFileList, flashFile ? [flashFile] : [], () => {
      flashFile = null;
      updateFlashFile();
    });
  }

  if (flashInput) {
    flashInput.addEventListener('change', () => {
      const file = flashInput.files?.[0];
      flashInput.value = '';
      clearError('flash-photo');
      if (!file) return;

      const validation = validateImageFile(file);
      if (!validation.valid) {
        showError('flash-photo', validation.error!);
        return;
      }

      if (flashFileList) flashFileList.innerHTML = '';
      showPreparing(flashFileList);
      pendingFiles = compressImage(file).then((compressed) => {
        flashFile = compressed;
        updateFlashFile();
      });
    });
  }

  // =======================
  // VALIDATION EN TEMPS RÉEL
  // =======================

  // Validation email en temps réel
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  if (emailInput) {
    emailInput.addEventListener('blur', () => {
      const validation = validateEmail(emailInput.value);
      if (!validation.valid && emailInput.value.length > 0) {
        showError('email', validation.error!);
      } else {
        clearError('email');
      }
    });
  }

  // Validation téléphone en temps réel
  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
  if (phoneInput) {
    phoneInput.addEventListener('blur', () => {
      if (phoneInput.value.length > 0) {
        const validation = validatePhone(phoneInput.value);
        if (!validation.valid) {
          showError('phone', validation.error!);
        } else {
          clearError('phone');
        }
      }
    });
  }

  // Validation Instagram en temps réel
  const instagramInput = document.getElementById('instagram') as HTMLInputElement | null;
  if (instagramInput) {
    instagramInput.addEventListener('blur', () => {
      if (instagramInput.value.length > 0) {
        const validation = validateInstagram(instagramInput.value);
        if (!validation.valid) {
          showError('instagram', validation.error!);
        } else {
          clearError('instagram');
        }
      }
    });
  }

  // Détection d'URLs dans la description
  if (projectTextarea) {
    projectTextarea.addEventListener('blur', () => {
      const warningElement = document.getElementById('warning-project');
      if (containsURL(projectTextarea.value)) {
        const urlCount = countURLs(projectTextarea.value);
        if (warningElement) {
          warningElement.textContent = `⚠️ ${urlCount} lien(s) détecté(s). Ils seront neutralisés pour votre sécurité.`;
          warningElement.style.display = 'block';
        }
      } else {
        if (warningElement) {
          warningElement.style.display = 'none';
        }
      }
    });
  }

  // =======================
  // SOUMISSION DU FORMULAIRE
  // =======================
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      clearAllErrors();

      // 1. Vérifier le honeypot (protection anti-bot)
      if (honeypotField && honeypotField.value !== '') {
        console.warn('Spam détecté via honeypot');
        return;
      }

      // Photos encore en préparation : on attend qu'elles soient prêtes
      await pendingFiles;

      // 2. Collecter les données
      const value = (id: string) =>
        (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? '';
      const isFlash = Boolean(flashRadio?.checked);
      const formData: SecurityFormData = {
        name: (document.getElementById('name') as HTMLInputElement).value,
        email: (document.getElementById('email') as HTMLInputElement).value,
        phone: (document.getElementById('phone') as HTMLInputElement)?.value,
        instagram: (document.getElementById('instagram') as HTMLInputElement)?.value,
        projectType: isFlash ? 'flash' : 'freehand',
        flashPhoto: Boolean(flashFile),
        flashBodyPart: value('flash-body-part'),
        flashSize: value('flash-size'),
        flashAvailability: value('flash-availability'),
        persoBodyPart: value('perso-body-part'),
        persoSize: value('perso-size'),
        project: projectTextarea?.value || '',
        budget: (document.getElementById('budget') as HTMLSelectElement)?.value,
        availability: (document.getElementById('availability') as HTMLTextAreaElement)?.value,
        honeypot: honeypotField?.value,
      };

      // 3. Validation complète
      const validation = validateFormData(formData);

      if (!validation.valid) {
        // Afficher les erreurs
        Object.entries(validation.errors).forEach(([field, message]) => {
          showError(field, message);
        });

        // Scroll vers la première erreur
        const firstError = document.querySelector('.form-group.has-error');
        if (firstError) {
          firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        return;
      }

      // 4. Afficher les avertissements si présents
      if (validation.warnings.length > 0) {
        const warningElement = document.getElementById('warning-project');
        if (warningElement) {
          warningElement.textContent = validation.warnings.join('\n');
          warningElement.style.display = 'block';
        }
      }

      // 5. Préparer l'envoi vers Netlify Forms
      // FormData(form) reprend tous les champs nommés (dont form-name et bot-field) ;
      // les photos d'inspiration sont remplacées par la sélection gérée en JS
      // (glisser-déposer compris), à raison d'un fichier par champ.
      // Seules les photos du type choisi sont envoyées (l'autre partie est masquée)
      const payload = new FormData(form);
      ['flash-photo', 'photos', 'photos-2', 'photos-3', 'photos-4', 'photos-5'].forEach(key => payload.delete(key));
      const filesToSend = isFlash ? (flashFile ? [flashFile] : []) : selectedFiles;
      if (isFlash && flashFile) {
        payload.append('flash-photo', flashFile);
      } else if (!isFlash) {
        selectedFiles.forEach((file, index) => {
          payload.append(index === 0 ? 'photos' : `photos-${index + 1}`, file);
        });
      }

      const totalSize = filesToSend.reduce((sum, file) => sum + file.size, 0);
      if (totalSize > MAX_SUBMISSION_SIZE) {
        showStatus(
          'error',
          'Tes photos sont trop lourdes pour être envoyées ensemble (8 Mo maximum au total). Retire une photo ou réduis leur taille, puis réessaie.'
        );
        return;
      }

      // 6. Envoyer le formulaire
      hideStatus();
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Envoi en cours…';
      }

      try {
        const response = await fetch('/', {
          method: 'POST',
          body: payload,
        });

        if (!response.ok) {
          throw new Error(`Réponse ${response.status}`);
        }

        form.reset();
        selectedFiles = [];
        updateFileList();
        flashFile = null;
        updateFlashFile();
        clearAllErrors();
        if (sectionFlash) sectionFlash.style.display = 'none';
        if (sectionProjetPerso) sectionProjetPerso.style.display = 'none';
        const warningElement = document.getElementById('warning-project');
        if (warningElement) warningElement.style.display = 'none';

        showStatus('success', SUCCESS_MESSAGE);
      } catch (error) {
        console.error("Erreur lors de l'envoi du formulaire :", error);
        showStatus('error', ERROR_MESSAGE);
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'Envoyer la demande';
        }
      }
    });
  }
</script>
