---
// Galerie de tatouages - réalisations gérées dans Sanity (tattoo, du plus récent au plus ancien)
// Une vignette par tattoo : la première photo sert d'image principale.
// Mosaïque bord à bord : 9 réalisations max + une case « Voir plus » vers Instagram.
import { getTattoos } from '../lib/sanity/api';
import { squareImage } from '../lib/sanity/image';
import { siteConfig } from '../config/seo';

const MAX_IMAGES = 9;

const galleryImages = (await getTattoos()).slice(0, MAX_IMAGES).map((tattoo) => {
  const cover = tattoo.images[0];
  return {
    alt: cover.alt,
    ...squareImage(cover.image, { widths: [300, 450, 600, 900] }),
  };
});
---

<section id="galerie" class="gallery">
  <div class="container">
    <header class="gallery-head">
      <span class="eyebrow">Dernières créations</span>
      <h2>Galerie</h2>
      <p class="gallery-intro">
        Découvrez une sélection de tatouages handpoke réalisés à Rennes. Chaque pièce est unique, faite avec soin et ne peut être reproduite qu’une seule fois.
      </p>
    </header>
  </div>

  {galleryImages.length > 0 && (
    <div class="gallery-grid">
      {
        galleryImages.map((image) => (
          <div class="gallery-item">
            <img
              src={image.src}
              srcset={image.srcset}
              sizes="(max-width: 768px) 50vw, 20vw"
              width={image.size}
              height={image.size}
              alt={image.alt}
              loading="lazy"
              decoding="async"
              class="gallery-image"
            />
          </div>
        ))
      }
      <a
        href={siteConfig.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="gallery-more"
      >
        <span>Voir plus →</span>
      </a>
    </div>
  )}

  <div class="container">
    <p class="gallery-note">
      Pour discuter d'un projet ou voir plus de réalisations, rendez-vous dans la section{' '}
      <a href="#contact">Contact</a> ou sur{' '}
      <a
        href="https://instagram.com/marah.pokes"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram @marah.pokes
      </a>
    </p>
  </div>
</section>

<style>
  .gallery-head {
    max-width: 720px;
    margin-bottom: var(--spacing-md);
  }

  .gallery-head h2 {
    margin-bottom: 1rem;
  }

  .gallery-intro {
    color: var(--ink-soft);
  }

  /* Mosaïque bord à bord, joints très fins */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 3px;
  }

  .gallery-item,
  .gallery-more {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .gallery-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.04);
  }

  /* Case « Voir plus » */
  .gallery-more {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-deep);
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .gallery-more span {
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--accent-light);
  }

  .gallery-more:hover {
    background: var(--accent);
    color: var(--ink);
  }

  .gallery-note {
    margin-top: var(--spacing-md);
    color: var(--ink-muted);
  }

  .gallery-note a {
    color: var(--accent-light);
    border-bottom: 1px solid currentColor;
  }

  .gallery-note a:hover {
    color: var(--ink);
  }

  /* Mobile : 2 colonnes */
  @media screen and (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
