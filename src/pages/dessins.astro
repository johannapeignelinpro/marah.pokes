---
// Page Dessins : illustrations de Marah gérées dans Sanity (document « illustration »).
// Galerie en lignes justifiées : chaque dessin garde ses proportions d'origine et
// occupe une largeur proportionnelle à son ratio. Sur une même ligne, tous les
// dessins ont la même hauteur : un paysage A3 prend naturellement deux fois la
// largeur d'un portrait A3. Rien n'est recadré, ni dans la grille ni en grand.
// La mise en page découle du ratio de chaque image : un dessin ajouté dans
// Sanity trouve sa place tout seul au prochain build.
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { getIllustrations } from '../lib/sanity/api';
import { naturalImage } from '../lib/sanity/image';
import { siteConfig } from '../config/seo';

// Hauteur de ligne de référence (desktop / tablette), transmise au CSS :
// sert à estimer la largeur affichée de chaque vignette pour l'attribut sizes.
const ROW_HEIGHT = { desktop: 340, tablet: 260 };
// Une ligne peut s'étirer au-delà de sa hauteur de référence pour remplir la largeur
const ROW_STRETCH = 1.5;

const drawings = (await getIllustrations()).map((drawing) => {
  const { ratio } = drawing;
  return {
    ...drawing,
    // Traits fins et pointillisme : qualité élevée, plusieurs largeurs pour ne
    // jamais envoyer le scan d'origine en vignette
    thumb: naturalImage(drawing.image, { widths: [400, 600, 800, 1000, 1300, 1600], quality: 85 }),
    thumbSizes: [
      '(max-width: 768px) calc(100vw - 2.5rem)',
      `(max-width: 1024px) ${Math.round(ratio * ROW_HEIGHT.tablet * ROW_STRETCH)}px`,
      `${Math.round(ratio * ROW_HEIGHT.desktop * ROW_STRETCH)}px`,
    ].join(', '),
    full: naturalImage(drawing.image, { widths: [1000, 1400, 1800, 2400], quality: 90 }),
    // En grand, la hauteur d'écran limite l'image : largeur affichée ≈ ratio × hauteur
    fullSizes: `(max-width: 768px) 100vw, calc(${ratio.toFixed(3)} * 100vh)`,
  };
});

const title = `Dessins & illustrations | ${siteConfig.name}`;
const description = `Découvrez les dessins et illustrations de ${siteConfig.name}, tatoueuse et illustratrice à ${siteConfig.location.city}. Un univers de lignes fines, de formes organiques et de motifs ornementaux.`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

/** Ligne discrète sous le titre : technique et année, seulement si renseignées */
const detailsOf = (drawing: (typeof drawings)[number]) =>
  [drawing.technique, drawing.year].filter(Boolean).join(', ');

// Données structurées : la page comme galerie (CollectionPage) et chaque dessin
// comme ImageObject, avec les seules informations saisies dans Sanity
const creator = {
  '@type': 'Person',
  name: siteConfig.name,
  url: siteConfig.url,
  sameAs: Object.values(siteConfig.social).filter(Boolean),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Dessins & illustrations',
  description,
  url: pageUrl,
  inLanguage: 'fr-FR',
  isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteConfig.url },
  author: creator,
  hasPart: drawings.map((drawing) => ({
    '@type': 'ImageObject',
    name: drawing.title || undefined,
    description: drawing.description ?? drawing.alt,
    contentUrl: drawing.full.src,
    thumbnailUrl: drawing.thumb.src,
    width: drawing.full.width,
    height: drawing.full.height,
    dateCreated: drawing.year ? String(drawing.year) : undefined,
    creator,
    creditText: siteConfig.name,
    copyrightNotice: `© ${siteConfig.name}`,
  })),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <!-- « < » échappé : les textes saisis dans Sanity ne peuvent pas fermer la balise -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\u003c')} />
  </Fragment>

  <section class="drawings" aria-labelledby="drawings-title">
    <div class="container">
      <header class="drawings-head" data-reveal>
        <span class="eyebrow">Sur papier</span>
        <h1 id="drawings-title">Dessins &amp; illustrations</h1>
        <p class="drawings-intro">
          Le dessin est au cœur de ma pratique artistique. À travers les lignes fines, les points et
          les formes organiques, j'explore un univers mêlant abstraction, ornementation et mouvement.
          Cette galerie rassemble une sélection de mes dessins et illustrations, réalisés au fil de
          mes inspirations.
        </p>
      </header>

      {drawings.length > 0 ? (
        <div class="drawings-grid" style={`--row-height-desktop: ${ROW_HEIGHT.desktop}px; --row-height-tablet: ${ROW_HEIGHT.tablet}px`}>
          {drawings.map((drawing, i) => (
            <figure
              class="drawing-item"
              data-orientation={drawing.orientation}
              data-reveal="fade"
              style={`--ratio: ${drawing.ratio.toFixed(4)}; --reveal-i: ${i % 4}`}
            >
            <a
              href={drawing.full.src}
              class="drawing"
              data-lightbox="drawings-lightbox"
              data-srcset={drawing.full.srcset}
              data-sizes={drawing.fullSizes}
              data-width={drawing.full.width}
              data-height={drawing.full.height}
              data-title={drawing.title}
              aria-haspopup="dialog"
            >
              <img
                src={drawing.thumb.src}
                srcset={drawing.thumb.srcset}
                sizes={drawing.thumbSizes}
                width={drawing.thumb.width}
                height={drawing.thumb.height}
                alt={drawing.alt}
                loading={i < 4 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
            {/* Titre et informations dans le HTML, sans attendre l'ouverture en grand */}
            {drawing.title && (
              <figcaption class="drawing-caption">
                <span class="drawing-title">{drawing.title}</span>
                {detailsOf(drawing) && <span class="drawing-details">{detailsOf(drawing)}</span>}
                {drawing.description && <span class="drawing-description">{drawing.description}</span>}
              </figcaption>
            )}
            </figure>
          ))}
        </div>
      ) : (
        <p class="drawings-empty">Les dessins arrivent très bientôt.</p>
      )}

      <div class="drawings-outro">
        <p>
          Mon travail sur papier nourrit aussi ma pratique du tatouage, où je retrouve ce même intérêt
          pour les lignes, les motifs et les compositions organiques.
        </p>
        <a href="/#galerie" class="link-underline">Voir la galerie de tatouages →</a>
      </div>

      <p class="drawings-note">
        Pour un projet de tatouage inspiré d'un dessin, rendez-vous dans la section{' '}
        <a href="/#contact">Contact</a> ou sur{' '}
        <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer">
          Instagram {siteConfig.instagram}
        </a>
      </p>
    </div>
  </section>

  {drawings.length > 0 && (
    <Lightbox id="drawings-lightbox" label="Dessin en grand" navigation maxWidth="1600px" />
  )}
</BaseLayout>

<style>
  .drawings {
    padding-top: calc(var(--header-height) + var(--spacing-lg));
  }

  .drawings-head {
    max-width: 720px;
    margin-bottom: var(--spacing-lg);
  }

  .drawings-intro {
    color: var(--ink-soft);
  }

  /* Lignes justifiées : la largeur de base de chaque dessin vaut ratio × hauteur de
     ligne, et l'espace restant se répartit au prorata du ratio. Toutes les œuvres
     d'une ligne gardent donc la même hauteur et leurs proportions d'origine. */
  .drawings-grid {
    --row-height: var(--row-height-desktop);
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 1.25rem;
    --reveal-step: 60ms;
  }

  /* Dernière ligne : pas d'étirement, les dessins restent à la hauteur de référence */
  .drawings-grid::after {
    content: '';
    flex-grow: 1000000;
  }

  /* La figure occupe la place dans la ligne ; la légende s'ajoute sous l'image
     sans changer sa hauteur : les dessins d'une ligne restent alignés */
  .drawing-item {
    flex: var(--ratio) 1 calc(var(--ratio) * var(--row-height));
    min-width: 0;
  }

  .drawing {
    aspect-ratio: var(--ratio);
    display: block;
    overflow: hidden;
    border-radius: var(--radius-img);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    cursor: zoom-in;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  /* L'image remplit exactement un cadre à ses propres proportions : contain ne
     sert que de garde-fou, rien n'est jamais coupé */
  .drawing img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (hover: hover) and (pointer: fine) {
    .drawing:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-strong);
    }
  }

  .drawing:focus-visible {
    outline-offset: 4px;
  }

  .drawing-caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.75rem;
    padding: 0 0.15rem;
    line-height: 1.4;
  }

  .drawing-title {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .drawing-details {
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .drawing-description {
    margin-top: 0.2rem;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }

  /* Lien vers les tatouages : discret, séparé de la galerie par un filet */
  .drawings-outro {
    max-width: 720px;
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--line);
  }

  .drawings-outro p {
    margin-bottom: 1rem;
  }

  .drawings-empty {
    color: var(--ink-muted);
    font-style: italic;
  }

  .drawings-note {
    margin-top: var(--spacing-md);
    color: var(--ink-muted);
  }

  .drawings-note a {
    color: var(--link);
    border-bottom: 1px solid currentColor;
  }

  .drawings-note a:hover {
    color: var(--ink);
  }

  @media screen and (max-width: 1024px) {
    .drawings-grid {
      --row-height: var(--row-height-tablet);
      gap: 1.75rem 1rem;
    }
  }

  /* Mobile : un dessin par ligne, pleine largeur, hauteur selon son ratio */
  @media screen and (max-width: 768px) {
    .drawings {
      padding-top: calc(var(--header-height) + var(--spacing-md));
    }

    .drawings-head {
      margin-bottom: var(--spacing-md);
    }

    .drawings-grid {
      flex-direction: column;
      gap: 1.75rem;
      --reveal-step: 40ms;
    }

    .drawings-grid::after {
      content: none;
    }

    .drawing-item {
      flex: none;
      width: 100%;
    }

    .drawings-outro {
      margin-top: var(--spacing-md);
    }
  }
</style>
