---
import { reviews, googleReviews } from '../data/reviews';

const stars = (rating: number) => '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating));
---

<section id="avis" class="reviews">
  <div class="container">
    <h2 class="text-center">Ils me font confiance</h2>

    <div class="reviews-summary text-center">
      <span class="reviews-score">{googleReviews.rating.toFixed(1).replace('.', ',')}</span>
      <span class="reviews-stars" aria-hidden="true">{stars(googleReviews.rating)}</span>
      {googleReviews.count > 0 && (
        <span class="reviews-count">{googleReviews.count} avis sur Google</span>
      )}
    </div>

    <div class="reviews-grid">
      {
        reviews.map((review) => (
          <figure class="review-card">
            <div class="review-stars" aria-label={`Note : ${review.rating} sur 5`}>
              {stars(review.rating)}
            </div>
            <blockquote class="review-text">
              {review.text.split('\n').map((paragraph) => <p>{paragraph}</p>)}
            </blockquote>
            <figcaption class="review-author">
              {review.author}
              <span class="review-date">{review.date}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="text-center mt-md">
      <a href={googleReviews.url} target="_blank" rel="noopener noreferrer" class="btn">
        Voir tous les avis sur Google
      </a>
    </div>
  </div>
</section>

<style>
  .reviews {
    background-color: rgba(255, 248, 240, 0.7);
  }

  .reviews-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--spacing-md);
  }

  .reviews-score {
    font-family: 'Rozha One', serif;
    font-size: 2rem;
    color: var(--color-sable);
    line-height: 1;
  }

  .reviews-stars,
  .review-stars {
    color: var(--color-sable);
    letter-spacing: 0.1em;
  }

  .reviews-stars {
    font-size: 1.25rem;
  }

  .reviews-count {
    color: var(--text-secondary);
    font-style: italic;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin: 0;
    padding: var(--spacing-md);
    background-color: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-sable-light);
  }

  .review-text {
    flex: 1;
    margin: 0;
  }

  .review-text p {
    margin-bottom: 0.5rem;
    font-style: italic;
    color: var(--text-primary);
  }

  .review-author {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.95rem;
    color: var(--color-sable-dark);
  }

  .review-date {
    display: block;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-light);
  }

  @media screen and (max-width: 768px) {
    .reviews-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
    }

    .review-card {
      padding: var(--spacing-sm);
    }
  }
</style>
