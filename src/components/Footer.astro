---
import { siteConfig } from '../config/seo';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h4>{siteConfig.name}</h4>
        <p>Tatouage handpoke à Rennes</p>
        <p class="footer-tagline">{siteConfig.slogan}</p>
      </div>

      <div class="footer-section">
        <h4>Navigation</h4>
        <nav class="footer-nav">
          <a href="#hero">Accueil</a>
          <a href="#a-propos">À propos</a>
          <a href="#galerie">Galerie</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>

      <div class="footer-section">
        <h4>Suivez-moi</h4>
        <div class="social-links">
          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            Instagram
          </a>
          <!-- TODO: Ajouter d'autres réseaux sociaux si nécessaire -->
        </div>
      </div>

      <div class="footer-section">
        <h4>Infos pratiques</h4>
        <p>Sur rendez-vous uniquement</p>
        <p>{siteConfig.location.city}, {siteConfig.location.region}</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        &copy; {currentYear} {siteConfig.name}. Tous droits réservés.
      </p>
      <p class="footer-credits">
        Site créé avec <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-sable);
    color: var(--color-beige);
    padding: var(--spacing-lg) 0 var(--spacing-md);
    margin-top: var(--spacing-xl);
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }

  .footer-section h4 {
    font-family: 'Amiri', serif;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-beige);
    margin-bottom: var(--spacing-sm);
  }

  .footer-section p {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 0.5rem;
    color: rgba(255, 248, 240, 0.9);
  }

  .footer-tagline {
    font-size: 0.85rem;
    font-style: italic;
    color: rgba(255, 248, 240, 0.8);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a,
  .social-links a {
    color: var(--color-beige);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .footer-nav a:hover,
  .social-links a:hover {
    color: var(--color-sable-light);
    text-decoration: underline;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 248, 240, 0.3);
    padding-top: var(--spacing-md);
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    color: rgba(255, 248, 240, 0.8);
  }

  .footer-credits a {
    color: var(--color-beige);
    text-decoration: underline;
  }

  @media screen and (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
</style>
