# Variables à renseigner dans .env (local) et dans Netlify :
# Site configuration > Environment variables

# Sanity — identifiants publics (non secrets)
# Project ID : sanity.io/manage > projet > "Project ID"
PUBLIC_SANITY_PROJECT_ID=126szpop
PUBLIC_SANITY_DATASET=production

# Token de lecture Sanity (SECRET — ne jamais committer)
# Dataset privé : sanity.io/manage > projet > API > Tokens > Add API token, rôle "Viewer"
SANITY_API_READ_TOKEN=

# Avis Google (API Places, lus au build). Sans elles, les avis de secours s'affichent.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Build hook Netlify : appelé chaque mois par netlify/functions/rebuild-avis.mjs
# pour rafraîchir les avis (Netlify uniquement)
BUILD_HOOK_URL=

# true = le site demande aux moteurs de ne pas l'indexer (préproduction).
# À supprimer dans Netlify pour la mise en ligne.
SITE_NOINDEX=false
