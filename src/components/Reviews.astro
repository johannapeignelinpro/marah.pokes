---
import { reviews, googleReviews } from '../data/reviews';

const stars = (rating: number) => '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating));
---

<section id="avis" class="reviews section-alt">
  <div class="container reviews-layout">
    <aside class="reviews-summary">
      <span class="reviews-kicker script">Avis Google</span>
      <h2>Ils me font confiance</h2>
      <div class="reviews-score-row">
        <span class="reviews-score">{googleReviews.rating.toFixed(1).replace('.', ',')}</span>
        <div>
          <span class="reviews-stars" aria-hidden="true">{stars(googleReviews.rating)}</span>
          {googleReviews.count > 0 && (
            <span class="reviews-count">{googleReviews.count} avis sur Google</span>
          )}
        </div>
      </div>
      <a href={googleReviews.url} target="_blank" rel="noopener noreferrer" class="link-underline">
        Voir tous les avis sur Google →
      </a>
    </aside>

    <div class="reviews-grid">
      {
        reviews.map((review) => (
          <figure class="review-card">
            <figcaption class="review-author">
              <span class="review-avatar" aria-hidden="true">{review.author.charAt(0)}</span>
              <span>
                {review.author}
                <span class="review-stars" aria-label={`Note : ${review.rating} sur 5`}>
                  {stars(review.rating)}
                </span>
              </span>
              <span class="review-date">{review.date}</span>
            </figcaption>
            <blockquote class="review-text">
              {review.text.split('\n').map((paragraph) => <p>{paragraph}</p>)}
            </blockquote>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reviews-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.1fr);
    gap: var(--spacing-lg);
    align-items: start;
  }

  .reviews-summary {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .reviews-kicker {
    display: block;
    font-size: 2rem;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .reviews-score-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.5rem 0 1.75rem;
  }

  .reviews-score {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 4rem;
    line-height: 1;
    color: var(--ink);
  }

  .reviews-score::before {
    content: '[';
    color: var(--accent-light);
    font-weight: 400;
  }

  .reviews-score::after {
    content: ']';
    color: var(--accent-light);
    font-weight: 400;
  }

  .reviews-stars,
  .review-stars {
    display: block;
    color: var(--accent-light);
    letter-spacing: 0.15em;
  }

  .reviews-stars {
    font-size: 1.1rem;
  }

  .reviews-count {
    display: block;
    font-size: 1rem;
    color: var(--ink-muted);
  }

  /* Colonnes façon mosaïque : les avis longs ne laissent pas de trous */
  .reviews-grid {
    columns: 2;
    column-gap: 1.25rem;
  }

  .review-card {
    break-inside: avoid;
    margin: 0 0 1.25rem;
    padding: 1.75rem;
    background-color: var(--surface);
    border: 1px solid var(--line);
  }

  .review-author {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    margin-bottom: 1.1rem;
  }

  .review-avatar {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
    font-style: normal;
    font-size: 1.1rem;
    font-family: var(--font-body);
  }

  .review-stars {
    font-family: var(--font-body);
    font-size: var(--fs-small);
  }

  .review-date {
    align-self: start;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .review-text {
    margin: 0;
  }

  .review-text p {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }

  .review-text p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 1024px) {
    .reviews-layout {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .reviews-summary {
      position: static;
    }
  }

  @media screen and (max-width: 768px) {
    .reviews-grid {
      columns: 1;
    }

    .review-card {
      padding: 1.35rem;
      margin-bottom: 1rem;
    }

    .reviews-score {
      font-size: 3.2rem;
    }
  }
</style>
