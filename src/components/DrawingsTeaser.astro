---
// Accueil : encart vers la page Dessins (dessins au stylo de Marah), avec son dernier dessin en petit
import { Image } from 'astro:assets';
import dessinImage from '../assets/images/editorial/dessin-encre-lignes-organiques-marah-chenaina-rennes.jpg';
---

<section id="dessins" class="drawings-teaser section-alt" aria-labelledby="drawings-teaser-title">
  <div class="container drawings-teaser-inner">
    <figure class="frame drawings-teaser-image" data-reveal>
      <div class="frame-inner">
        <Image
          src={dessinImage}
          alt="Dessin au stylo de Marah Chenaïna : lignes fines ondulantes formant des tourbillons organiques"
          widths={[300, 450, 600, 800]}
          sizes="(max-width: 768px) 60vw, 300px"
          quality={85}
          loading="lazy"
        />
      </div>
    </figure>
    <div class="drawings-teaser-text" data-reveal style="--reveal-i: 1">
      <span class="eyebrow">Illustratrice à Rennes</span>
      <h2 id="drawings-teaser-title">Dessins au stylo</h2>
      <p>
        Les lignes que l'on retrouve dans ses tatouages naissent d'abord sur le papier.
        Au stylo fin, Marah explore le mouvement par la répétition de lignes et de points :
        des compositions abstraites et organiques, nées d'une longue patience, où la lumière
        se révèle dans l'ombre.
      </p>
      <a href="/dessins/" class="btn btn-ghost">Découvrir ses dessins</a>
    </div>
  </div>
</section>

<style>
  .drawings-teaser-inner {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 560px);
    justify-content: center;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .drawings-teaser-text p {
    color: var(--ink-soft);
    margin-bottom: 1.75rem;
  }

  @media screen and (max-width: 768px) {
    .drawings-teaser-inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .drawings-teaser-image {
      width: min(60%, 260px);
      margin: 0 auto;
    }
  }
</style>
