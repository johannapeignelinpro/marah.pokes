---
// Galerie de tatouages - 8 premières images du dossier dessins
const galleryImages = [
  { src: '/assets/gallery/dessins/20251201_170125.jpg', alt: 'Tatouage handpoke par Marah' },
  { src: '/assets/gallery/dessins/20251211_182304.jpg', alt: 'Tatouage handpoke par Marah' },
  { src: '/assets/gallery/dessins/20251223_001807_exported_1665.jpg', alt: 'Tatouage handpoke par Marah' },
  { src: '/assets/gallery/dessins/20260108_220636.jpg', alt: 'Tatouage handpoke par Marah' },
  { src: '/assets/gallery/dessins/20260110_165406.jpg', alt: 'Tatouage handpoke par Marah' },
  { src: '/assets/gallery/dessins/20260113_175654.jpg', alt: 'Tatouage handpoke par Marah' },
  { src: '/assets/gallery/dessins/20260117_161749.jpg', alt: 'Tatouage handpoke par Marah' },
  { src: '/assets/gallery/dessins/20260121_152725.jpg', alt: 'Tatouage handpoke par Marah' },
];
---

<section id="galerie" class="gallery">
  <div class="container-full">
    <h2 class="text-center">Galerie</h2>
    <p class="gallery-intro text-center">
      Découvrez une sélection de mes réalisations handpoke. Chaque tatouage est unique et réalisé avec soin.
    </p>

    <div class="gallery-grid">
      {
        galleryImages.map((image) => (
          <div class="gallery-item">
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              class="gallery-image"
            />
          </div>
        ))
      }
    </div>

    <p class="gallery-note text-center mt-lg">
      Pour discuter d'un projet ou voir plus de réalisations, rendez-vous dans la section{' '}
      <a href="#contact">Contact</a> ou sur{' '}
      <a
        href="https://instagram.com/marah.pokes"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram @marah.pokes
      </a>
    </p>
  </div>
</section>

<style>
  .gallery {
    background-color: transparent;
    padding: var(--spacing-xl) 0;
  }

  .container-full {
    width: 100%;
    max-width: 100%;
    padding: 0 var(--spacing-md);
  }

  .gallery-intro {
    max-width: 700px;
    margin: 0 auto var(--spacing-lg);
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: var(--spacing-lg);
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    cursor: pointer;
  }

  .gallery-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(186, 154, 118, 0.3);
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.05);
  }

  .gallery-note {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .gallery-note a {
    color: var(--color-sable);
    font-weight: 700;
    text-decoration: underline;
  }

  .gallery-note a:hover {
    color: var(--color-sable-dark);
  }

  /* Tablette */
  @media screen and (max-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .gallery {
      padding: var(--spacing-lg) 0;
    }

    .container-full {
      padding: 0 var(--spacing-sm);
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .gallery-intro {
      font-size: 0.9rem;
      margin-bottom: var(--spacing-md);
    }

    .gallery-note {
      font-size: 0.85rem;
    }
  }
</style>
