---
// Galerie de tatouages - réalisations gérées dans Sanity (tattoo, du plus récent au plus ancien)
// Une vignette par tattoo : la première photo sert d'image principale.
// Mosaïque bord à bord : 9 réalisations max + une case « Voir plus » vers Instagram.
// Chaque vignette ouvre la photo entière (non recadrée) dans la lightbox partagée. Sans JS,
// le lien ouvre simplement l'image.
import { getTattoos } from '../lib/sanity/api';
import { squareImage, naturalImage } from '../lib/sanity/image';
import { siteConfig } from '../config/seo';
import Lightbox from './Lightbox.astro';

const MAX_IMAGES = 9;

const galleryImages = (await getTattoos()).slice(0, MAX_IMAGES).map((tattoo) => {
  const cover = tattoo.images[0];
  return {
    alt: cover.alt,
    title: tattoo.title?.trim() || '',
    thumb: squareImage(cover.image, { widths: [300, 450, 600, 900] }),
    full: naturalImage(cover.image, { widths: [800, 1200, 1600, 2000], quality: 85 }),
  };
});
---

<section id="galerie" class="gallery">
  <div class="container">
    <header class="gallery-head" data-reveal>
      <span class="eyebrow">Dernières créations</span>
      <h2>Galerie</h2>
      <p class="gallery-intro">
        Découvrez une sélection de tatouages handpoke réalisés à Rennes. Chaque pièce est unique, faite avec soin et ne peut être reproduite qu’une seule fois.
      </p>
    </header>
  </div>

  {galleryImages.length > 0 && (
    <div class="gallery-grid">
      {
        galleryImages.map((image, i) => (
          <a
            href={image.full.src}
            class="gallery-item"
            data-reveal="fade"
            style={`--reveal-i: ${i % 5}`}
            data-lightbox="gallery-lightbox"
            data-srcset={image.full.srcset}
            data-width={image.full.width}
            data-height={image.full.height}
            data-title={image.title}
            aria-haspopup="dialog"
          >
            <img
              src={image.thumb.src}
              srcset={image.thumb.srcset}
              sizes="(max-width: 768px) 50vw, 20vw"
              width={image.thumb.size}
              height={image.thumb.size}
              alt={image.alt}
              loading="lazy"
              decoding="async"
              class="gallery-image"
            />
          </a>
        ))
      }
      <a
        href={siteConfig.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="gallery-more"
        data-reveal="fade"
        style={`--reveal-i: ${galleryImages.length % 5}`}
      >
        <span>Voir plus →</span>
      </a>
    </div>
  )}

  <div class="container">
    <p class="gallery-note">
      Pour discuter d'un projet ou voir plus de réalisations, rendez-vous dans la section{' '}
      <a href="#contact">Contact</a> ou sur{' '}
      <a
        href="https://instagram.com/marah.pokes"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram @marah.pokes
      </a>
    </p>
  </div>

  {galleryImages.length > 0 && <Lightbox id="gallery-lightbox" label="Photo du tatouage en grand" />}
</section>

<style>
  .gallery-head {
    max-width: 720px;
    margin-bottom: var(--spacing-md);
  }

  .gallery-head h2 {
    margin-bottom: 1rem;
  }

  .gallery-intro {
    color: var(--ink-soft);
  }

  /* Mosaïque bord à bord, joints très fins */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 3px;
    border-radius: var(--radius-img);
    overflow: hidden;
    --reveal-step: 70ms;
  }

  .gallery-item,
  .gallery-more {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .gallery-item {
    display: block;
    cursor: zoom-in;
  }

  .gallery-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  /* Voile très léger au survol */
  .gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(47, 38, 32, 0.12);
    opacity: 0;
    transition: opacity var(--dur-fast) ease;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery-item:hover .gallery-image {
      transform: scale(1.04);
    }

    .gallery-item:hover::after {
      opacity: 1;
    }
  }

  .gallery-item:focus-visible {
    outline-offset: -4px;
  }

  /* Case « Voir plus » */
  .gallery-more {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-alt);
    color: var(--ink);
    font-size: var(--fs-caps);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .gallery-more span {
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--link);
  }

  .gallery-more:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .gallery-more:hover span {
    border-bottom-color: currentColor;
  }

  .gallery-note {
    margin-top: var(--spacing-md);
    color: var(--ink-muted);
  }

  .gallery-note a {
    color: var(--link);
    border-bottom: 1px solid currentColor;
  }

  .gallery-note a:hover {
    color: var(--ink);
  }

  /* Mobile : 2 colonnes, décalage des apparitions plus court */
  @media screen and (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      --reveal-step: 40ms;
    }
  }
</style>
